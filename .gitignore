# ── Seed one-shot do Diagnóstico (scripts/seed) ──────────────
# Dependências instaladas só localmente para a execução real.
scripts/seed/node_modules/
# Segredos de credencial — NUNCA versionar.
scripts/seed/.env*
scripts/seed/*service-account*.json
